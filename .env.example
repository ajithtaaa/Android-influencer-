# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Random long string used to sign user sessions (e.g. `openssl rand -hex 32`). REQUIRED in production.
APP_SECRET=

# Your public site URL, e.g. https://swapreel.vercel.app
PUBLIC_APP_URL=

# --- Higgsfield (leave empty to run in demo mode) ---
# From the Higgsfield API console, format KEY_ID:KEY_SECRET
HF_CREDENTIALS=
# Model endpoint path for video face swap, as shown in the Higgsfield API console
HF_SWAP_MODEL=
# Optional JSON body template; {{video_url}} and {{image_url}} are replaced.
# HF_SWAP_INPUT_TEMPLATE={"video_url":"{{video_url}}","image_url":"{{image_url}}"}

# --- Storage: Upstash Redis (Vercel Marketplace → Upstash adds these automatically) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Stripe (web checkout) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Play purchase verification ---
PLAY_PACKAGE_NAME=com.swapreel.app
# Full JSON of a Google Cloud service account linked in Play Console
PLAY_SERVICE_ACCOUNT_JSON=

# Free credits for new users (keep 0 in production to prevent abuse)
FREE_CREDITS=0
